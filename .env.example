# ── Database (Neon free tier). Use the *pooled* or direct connection string.
DATABASE_URL=postgresql://user:pass@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ── App URL (no trailing slash). On Vercel set to your production domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Auth (Better Auth). Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Resend free tier (100/day). Leave empty in dev: magic links are printed to the server console.
RESEND_API_KEY=
EMAIL_FROM="Torque <onboarding@resend.dev>"

# ── Encryption of users' AI API keys (AES-256-GCM). Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# ── Telegram bot (free). Create via @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random string; Telegram echoes it in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=

# ── Vercel Cron auth (Vercel sends "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=

# ── Vercel Blob (Hobby: 1 GB). Created automatically when you add a Blob store in the dashboard.
BLOB_READ_WRITE_TOKEN=
